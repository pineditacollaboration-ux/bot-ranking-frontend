// ─── Comando principal ────────────────────────────────────────────────────────

async function crearServidor(message, args, ctx) {
  const { Setting, COLORS, BOT_OWNER_ID, config } = ctx;
  const guild = message.guild;
  if (!guild) return;

  // Solo el owner del bot puede ejecutarlo
  const isOwner = Array.isArray(BOT_OWNER_ID)
    ? BOT_OWNER_ID.includes(message.author.id)
    : message.author.id === BOT_OWNER_ID;

  if (!isOwner) {
    return message.channel.send({ content: '🚫 Solo el **OWNER** del bot puede usar este comando.' }).catch(() => {});
  }

  const neededPerms = [F.ManageChannels, F.ViewChannel, F.ManageRoles, F.Administrator];
  const botPerms = guild.members.me?.permissions;
  console.log('[crearServidor] Permisos del bot:', botPerms ? botPerms.toArray() : 'No disponibles');
  
  if (!botPerms?.has(neededPerms)) {
    const missing = neededPerms.filter(p => !botPerms?.has(p));
    console.error('[crearServidor] Permisos faltantes:', missing);
    return message.channel.send({ content: `❌ El bot necesita los permisos: ${missing.join(', ')}` }).catch(() => {});
  }

  // Fetch del servidor
  await guild.roles.fetch().catch(() => {});
  await guild.channels.fetch().catch(() => {});

  // Detectar roles clave
  const staffIds = [...new Set([
    ...(config?.manageRole || []),
    ...(config?.staffRoleId || [])
  ])];
  
  // Encontrar roles VIP por nombre (que incluyan VIP)
  let vipRoleIds = guild.roles.cache
    .filter(r => r.name.toLowerCase().includes('vip'))
    .map(r => r.id);
  
  // Si no encuentra por nombre, usa el config fallback
  if (!vipRoleIds.length && config?.allowedRoles?.[0]) {
    vipRoleIds.push(config.allowedRoles[0]);
  }
  const everyoneId = guild.roles.everyone.id;

  const modVoiceRoles = guild.roles.cache.filter(r => 
    !r.permissions.has(PermissionsBitField.Flags.Administrator) &&
    (r.permissions.has(PermissionsBitField.Flags.MoveMembers) || 
     r.permissions.has(PermissionsBitField.Flags.MuteMembers) || 
     r.permissions.has(PermissionsBitField.Flags.DeafenMembers))
  ).map(r => r.id);

  const permCtx = { everyoneId, staffRoles: staffIds, vipRoleIds, modVoiceRoles };

  const totalCats = LAYOUT.length;
  const totalChs  = LAYOUT.reduce((s, g) => s + g.channels.length, 0);
  const code      = randCode(6);

  // Paleta de colores
  const C_BLUE  = 0x5865F2; // Discord Blurple / Royal Blue
  const C_GOLD  = 0xFFD700;
  const C_GREEN = COLORS?.SUCCESS  || 0x57F287;
  const C_RED   = COLORS?.ERROR    || 0xED4245;
  const C_WARN  = COLORS?.WARNING  || 0xFEE75C;

  // ── Embed de Preview ────────────────────────────────────────────────────────
  const staffMention = staffIds.length
    ? staffIds.slice(0, 3).map(id => `<@&${id}>`).join(' ')
    : '⚠️ ninguno detectado';
  const vipMention = vipRoleIds.length ? vipRoleIds.map(id => `<@&${id}>`).join(' ') : '⚠️ ninguno detectado';

  const previewEmbed = new EmbedBuilder()
    .setColor(C_BLUE)
    .setTitle('🏰  ROYAL RANKED — CREAR SERVIDOR')
    .setAuthor({ name: guild.name, iconURL: guild.iconURL?.() || undefined })
    .setDescription(
      [
        '```',
        `  Servidor    ${guild.name}`,
        `  Categorías  ${totalCats}`,
        `  Canales     ${totalChs}`,
        '```',
        '',
        '**📋  Estructura que se creará:**',
        '> 📗 Reglas  ·  ⚡ Cargos  ·  💬 Interacción',
        '> 🎫 Soporte  ·  🪙 Economía & Ranking',
        '> 🕹️ Fila Partidas FF (con espera 01~10)',
        '> ⚔️ Partidas Ranked (01~15)',
        '> 🌀 Canales Temporales  ·  🌟 Influencers  ·  📊 Stats Voz',
        '> 🔢 Contadores  ·  🔒 Logs Privados  ·  ⚙️ Staff',
        '',
        '**ℹ️  Importante:**',
        '> • No se modifican canales ni roles existentes.',
        '> • Todos los IDs se guardan automáticamente en la DB.',
        '> • Stats, filas, logs y voz temporal quedan listos.',
      ].join('\n')
    )
    .addFields(
      { name: '🛡️  Roles Staff detectados',  value: staffMention, inline: true },
      { name: '💎  Rol VIP detectado',        value: vipMention,   inline: true },
    )
    .setFooter({ text: 'Presioná CREAR para continuar  ·  Caduca en 90 s' })
    .setTimestamp();

  const row = new ActionRowBuilder().addComponents(
    new ButtonBuilder()
      .setCustomId('cs_confirm')
      .setLabel('CREAR ESTRUCTURA')
      .setEmoji('🏰')
      .setStyle(ButtonStyle.Primary),
    new ButtonBuilder()
      .setCustomId('cs_cancel')
      .setLabel('CANCELAR')
      .setEmoji('✖️')
      .setStyle(ButtonStyle.Secondary),
  );

  const previewMsg = await message.channel.send({ embeds: [previewEmbed], components: [row] }).catch(() => null);
  if (!previewMsg) return;

  // ── Collector botones ────────────────────────────────────────────────────────
  const btnCollector = previewMsg.createMessageComponentCollector({
    componentType: ComponentType.Button,
    time: 90_000,
    max: 1,
    filter: btn => btn.user.id === message.author.id,
  });

  btnCollector.on('end', async (collected, reason) => {
    if (reason !== 'ok' && previewMsg?.editable) {
      await previewMsg.edit({
        components: [],
        embeds: [
          EmbedBuilder.from(previewEmbed)
            .setColor(C_WARN)
            .setTitle('⏹️  OPERACIÓN CANCELADA')
            .setDescription('No se creó nada. Timeout o cancelación manual.')
            .setFooter({ text: 'Volvé a ejecutar !crearservidor para reintentar.' }),
        ],
      }).catch(() => {});
    }
  });

  btnCollector.on('collect', async btn => {
    if (btn.customId === 'cs_cancel') {
      btnCollector.stop('ok');
      await previewMsg.edit({
        components: [],
        embeds: [
          EmbedBuilder.from(previewEmbed)
            .setColor(C_WARN)
            .setTitle('⏹️  CANCELADO')
            .setDescription('No se creó nada en el servidor.')
            .setFooter({ text: 'Podés volver a ejecutar !crearservidor cuando quieras.' }),
        ],
      }).catch(() => {});
      return;
    }

    if (btn.customId !== 'cs_confirm') return;
    btnCollector.stop('ok');
    
    // Enviar respuesta inmediata para evitar timeout
    await btn.reply({ content: '🏗️ Iniciando creación del servidor...', flags: MessageFlags.Ephemeral }).catch(() => {});

    console.log('[crearServidor] Iniciando proceso de creación...');

    // ── CREACIÓN ─────────────────────────────────────────────────────────────
    await guild.members.fetch().catch(() => {});
    await guild.roles.fetch().catch(() => {});
    console.log('[crearServidor] Miembros y roles fetcheados');
    const totalMembers = guild.memberCount;
    const botCount     = guild.members.cache.filter(m => m.user.bot).size;
    const humanCount   = totalMembers - botCount;

    function resolveCounterName(ch) {
      if (!ch._counter) return ch.name;
      if (ch._counter === 'total') return `👥  miembros: ${totalMembers}`;
      if (ch._counter === 'human') return `🧑  humanos: ${humanCount}`;
      if (ch._counter === 'bots')  return `🤖  bots: ${botCount}`;
      return ch.name;
    }

    // Embed de progreso
    const progressEmbed = new EmbedBuilder()
      .setColor(C_BLUE)
      .setTitle('🏗️  CONSTRUYENDO EL SERVIDOR...')
      .setDescription(
        '```\n' +
        `  [${progressBar(0)}]  0 %\n` +
        '```\n' +
        '> Iniciando conexión con la API de Discord...'
      )
      .setFooter({ text: 'No cierres Discord durante el proceso.' });

    await previewMsg.edit({ embeds: [progressEmbed] }).catch(() => {});
    console.log('[crearServidor] Embed de progreso actualizado');

    // ── Contadores de resultado ───────────────────────────────────────────────
    let catsDone = 0, chsDone = 0, failed = 0, settingsSaved = 0;
    const failedList         = [];
    const voiceCatIds        = [];
    const queueCatIds        = [];
    let tempVoiceCatId       = null;
    let filaPartidasCatId    = null;
    let voiceStatsCatId      = null;

    async function updateProgress(label = '') {
      const done = catsDone + chsDone + failed;
      const pct  = Math.min(100, Math.round((done / (totalCats + totalChs)) * 100));
      try {
        await previewMsg.edit({
          embeds: [
            progressEmbed
                .setDescription(
                  '```\n' +
                  `  [${progressBar(pct)}]  ${pct} %\n` +
                  '```\n' +
                  `> 📁 Categorías  **${catsDone} / ${totalCats}**\n` +
                  `> 🔗 Canales     **${chsDone} / ${totalChs}**\n` +
                  `> ❌ Errores     **${failed}**\n` +
                  `> 💾 Settings    **${settingsSaved}** guardados` +
                  (label ? `\n> ⚡ ${label}` : '')
                ),
            ],
        }).catch(() => {});
      } catch {}
    }

      // ── Loop creación ─────────────────────────────────────────────────────────
      console.log('[crearServidor] Iniciando loop de creación de categorías...');
      console.log(`[crearServidor] Total categorías a crear: ${LAYOUT.length}`);
      const existingCats = guild.channels.cache.filter(c => c.type === ChannelType.GuildCategory).size;
      console.log(`[crearServidor] Categorías existentes en el servidor: ${existingCats}`);
      
      if (existingCats >= 500) {
        console.error('[crearServidor] ERROR: El servidor ya tiene 500 categorías (límite de Discord)');
        await message.channel.send({ content: '❌ El servidor ya tiene 500 categorías (límite de Discord). No se pueden crear más.' }).catch(() => {});
        return;
      }
      
      // Intentar crear una categoría de prueba primero con nombre simple
      console.log('[crearServidor] Creando categoría de prueba con nombre simple...');
      console.log('[crearServidor] Estado del cliente REST:', guild.client.rest ? 'Disponible' : 'No disponible');
      console.log('[crearServidor] Estado de WebSocket:', guild.client.ws.status === 0 ? 'Conectado' : 'Desconectado');
      console.log('[crearServidor] Guild ID:', guild.id);
      console.log('[crearServidor] Guild name:', guild.name);
      
      // Verificar conectividad con la API de Discord
      console.log('[crearServidor] Verificando conectividad con la API de Discord...');
      try {
        const botUser = await Promise.race([
          guild.client.rest.get(`/users/@me`),
          new Promise((_, reject) => 
            setTimeout(() => reject(new Error('Timeout verificando usuario actual')), 5000)
          )
        ]);
        console.log('[crearServidor] Usuario del bot:', botUser.username, 'ID:', botUser.id);
      } catch (userError) {
        console.error('[crearServidor] ERROR verificando usuario del bot:', userError);
        await message.channel.send({ content: `❌ Error conectando con la API de Discord: ${userError.message}. El token del bot podría estar revocado o hay problemas de red.` }).catch(() => {});
        return;
      }
      
      // Verificar información del guild
      console.log('[crearServidor] Verificando información del guild...');
      try {
        const guildInfo = await Promise.race([
          guild.client.rest.get(`/guilds/${guild.id}`),
          new Promise((_, reject) => 
            setTimeout(() => reject(new Error('Timeout verificando guild')), 5000)
          )
        ]);
        console.log('[crearServidor] Guild verificado:', guildInfo.name, 'ID:', guildInfo.id);
      } catch (guildError) {
        console.error('[crearServidor] ERROR verificando guild:', guildError);
        await message.channel.send({ content: `❌ Error verificando el guild: ${guildError.message}. El bot podría no tener acceso al servidor.` }).catch(() => {});
        return;
      }
      
      try {
        // Intentar usar el método del cliente original con timeout más largo
        console.log('[crearServidor] Intentando crear categoría vía método del cliente...');
        const testCat = await Promise.race([
          guild.channels.create({
            name: 'TEST-' + Date.now(),
            type: ChannelType.GuildCategory,
            reason: 'Test category',
          }),
          new Promise((_, reject) => 
            setTimeout(() => reject(new Error('Timeout creando categoría de prueba')), 30000)
          )
        ]);
        console.log('[crearServidor] Categoría de prueba creada exitosamente:', testCat.id);
        
        // Eliminar la categoría de prueba
        await testCat.delete().catch(() => {});
        console.log('[crearServidor] Categoría de prueba eliminada');
      } catch (testError) {
        console.error('[crearServidor] ERROR creando categoría de prueba:', testError);
        console.error('[crearServidor] Stack trace:', testError.stack);
        await message.channel.send({ content: `❌ Error creando categoría de prueba: ${testError.message}. La API de Discord podría estar teniendo problemas o hay rate limiting extremo. Intenta nuevamente en unos minutos.` }).catch(() => {});
        return;
      }
      
      for (const group of LAYOUT) {
        let catId = null;

        try {
          console.log(`[crearServidor] Creando categoría: ${group.category}`);
          
          // Primero crear la categoría sin permisos para evitar bloqueo
          const cat = await Promise.race([
            guild.channels.create({
              name: group.category,
              type: ChannelType.GuildCategory,
              reason: '!crearservidor — Royal Ranked',
            }),
            new Promise((_, reject) => 
              setTimeout(() => reject(new Error('Timeout creando categoría')), 30000)
            )
          ]);
          
          catId = cat.id;
          catsDone++;
          console.log(`[crearServidor] Categoría creada: ${group.category} (ID: ${catId})`);
          
          // Luego asignar permisos
          try {
            const perms = buildPerms(guild, group.visibility, permCtx, group);
            console.log(`[crearServidor] Asignando permisos a ${group.category}...`);
            await cat.edit({ permissionOverwrites: perms });
            console.log(`[crearServidor] Permisos asignados a ${group.category}`);
          } catch (permError) {
            console.error(`[crearServidor] Error asignando permisos a ${group.category}:`, permError);
            // Continuar aunque falle la asignación de permisos
          }

          // Registrar categorías especiales
          if (group._queueFila)       queueCatIds.push(cat.id);
          if (group._queuePartida)    queueCatIds.push(cat.id);
          if (group._voiceCat)        voiceCatIds.push(cat.id);
          if (group._tempVoiceCat)    tempVoiceCatId    = cat.id;
          if (group._filaPartidasCat) filaPartidasCatId = cat.id;
          if (group._statsVozCat)     voiceStatsCatId   = cat.id;

          // Guardar setting de categoría si corresponde
          if (group.settingCatKey && Setting) {
            try {
              await Setting.findByIdAndUpdate(group.settingCatKey, { value: cat.id }, { upsert: true });
              settingsSaved++;
            } catch (e) {
              failedList.push(`[Setting] ${group.settingCatKey}: ${e.message}`);
            }
          }
        } catch (e) {
          console.error(`[crearServidor] ERROR creando categoría ${group.category}:`, e);
          failed++;
          failedList.push(`[Cat] ${group.category}: ${e.message}`);
        }

        if (!catId) {
          chsDone += group.channels.length;
          continue;
        }

        for (const ch of group.channels) {
          try {
            const perms   = buildPerms(guild, group.visibility, permCtx, group, ch);
            const rawName = resolveCounterName(ch);
            const chName  = ch.type === ChannelType.GuildVoice ? capitalizeVoiceName(rawName) : rawName;
            const channelOptions = {
              name:                chName,
              type:                ch.type,
              parent:              catId,
              permissionOverwrites: perms,
              reason:              '!crearservidor — Royal Ranked',
            };
            // Agregar userLimit si está definido (para canales de voz)
            if (ch.userLimit && ch.type === ChannelType.GuildVoice) {
              channelOptions.userLimit = ch.userLimit;
            }
            const created = await guild.channels.create(channelOptions);
            chsDone++;

            if (ch.setting && Setting) {
              try {
                await Setting.findByIdAndUpdate(ch.setting, { value: created.id }, { upsert: true });
                settingsSaved++;
              } catch (e) {
                failedList.push(`[Setting] ${ch.setting}: ${e.message}`);
              }
            }
          } catch (e) {
            failed++;
            failedList.push(`[Ch] ${ch.name}: ${e.message}`);
          }

          // Actualizar progreso cada 15 items para evitar rate limiting
          if ((catsDone + chsDone + failed) % 15 === 0) {
            await updateProgress(group.category.replace(/^\S+\s+/, ''));
          }
        }
      }

      // ── Guardar settings batch ──────────────────────────────────────────────
      try {
        if (Setting) {
          if (tempVoiceCatId)      { await Setting.findByIdAndUpdate('tempVoiceCategoryId',    { value: tempVoiceCatId },    { upsert: true }); settingsSaved++; }
          if (voiceStatsCatId)     { await Setting.findByIdAndUpdate('voiceStatsCategoryId',   { value: voiceStatsCatId },   { upsert: true }); settingsSaved++; }
          if (queueCatIds.length)  { await Setting.findByIdAndUpdate('queueCategories',        { value: queueCatIds },       { upsert: true }); settingsSaved++; }
          if (filaPartidasCatId)   { await Setting.findByIdAndUpdate('allowedQueueCategoryId', { value: filaPartidasCatId }, { upsert: true }); settingsSaved++; }
          if (voiceCatIds.length)  { await Setting.findByIdAndUpdate('allowedVoiceCategories', { value: voiceCatIds },       { upsert: true }); settingsSaved++; }
        }
      } catch (e) {
        failedList.push(`[Batch-Settings]: ${e.message}`);
      }

      // ── Embed final ──────────────────────────────────────────────────────────
      const successRate = Math.round((catsDone + chsDone) / (totalCats + totalChs) * 100);
      const isSuccess   = failed === 0;

      const finalEmbed = new EmbedBuilder()
        .setColor(isSuccess ? C_GREEN : C_WARN)
        .setTitle(isSuccess ? '✅  SERVIDOR CREADO EXITOSAMENTE' : '⚠️  CREACIÓN COMPLETADA CON ERRORES')
        .setDescription(
          '```\n' +
          `  [${progressBar(successRate)}]  ${successRate} %\n` +
          '```'
        )
        .addFields(
          { name: '📁  Categorías',    value: `**${catsDone}** / ${totalCats}`,  inline: true },
          { name: '🔗  Canales',       value: `**${chsDone}** / ${totalChs}`,    inline: true },
          { name: '💾  Settings DB',   value: `**${settingsSaved}** guardados`,  inline: true },
          { name: '❌  Fallaron',      value: `**${failed}**`,                   inline: true },
          { name: '🗂️  Cats de Voz',   value: `**${voiceCatIds.length}** registradas`, inline: true },
          { name: '📋  Filas/Partidas',value: `**${queueCatIds.length}** categorías`,   inline: true },
          {
            name: '📌  IDs clave (guardadas en DB)',
            value: [
              `• \`tempVoiceCategoryId\`    ${tempVoiceCatId    ? `→ \`${tempVoiceCatId}\``    : '❌'}`,
              `• \`voiceStatsCategoryId\`   ${voiceStatsCatId   ? `→ \`${voiceStatsCatId}\``   : '❌'}`,
              `• \`queueCategories\`        → **${queueCatIds.length}** guardadas`,
              `• \`allowedQueueCategoryId\` ${filaPartidasCatId ? `→ \`${filaPartidasCatId}\`` : '❌'}`,
              `• \`allowedVoiceCategories\` → **${voiceCatIds.length}** guardadas`,
            ].join('\n'),
            inline: false,
          },
        )
        .setFooter({ text: `Finalizado · ${new Date().toLocaleString('es-CO')}  ·  Reiniciá el bot para aplicar los settings nuevos.` });

      if (failed > 0 && failedList.length > 0) {
        finalEmbed.addFields({
          name: `⚠️  Errores (${failed})`,
          value: failedList.slice(0, 10).join('\n') + (failed > 10 ? `\n+${failed - 10} más...` : ''),
        });
      }

      try { await message.channel.send({ embeds: [finalEmbed] }); } catch {}
      try { if (previewMsg?.deletable) await previewMsg.delete(); } catch {}
  });
}

module.exports = crearServidor;
