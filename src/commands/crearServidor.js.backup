// ─── Utilidades ──────────────────────────────────────────────────────────────

function randCode(n = 6) {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  let out = '';
  for (let i = 0; i < n; i++) out += chars[Math.floor(Math.random() * chars.length)];
  return out;
}

function normalize(s) {
  return String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
}

function findRoleByIdOrName(guild, ids = [], names = []) {
  for (const id of ids) {
    const r = guild.roles.cache.get(id);
    if (r) return r;
  }
  const normals = names.map(normalize);
  return guild.roles.cache.find(r => normals.includes(normalize(r.name))) || null;
}

function progressBar(pct, size = 18) {
  const filled = Math.round((pct / 100) * size);
  return '█'.repeat(filled) + '░'.repeat(size - filled);
}

// ─── Permisos ─────────────────────────────────────────────────────────────────

const F = PermissionsBitField.Flags;
const BASE_PUBLIC  = [F.ViewChannel, F.ReadMessageHistory, F.SendMessages, F.AddReactions, F.Connect];
const BASE_VIEW    = [F.ViewChannel, F.ReadMessageHistory];
// ManageChannels excluido de STAFF_FULL — solo roles específicos lo tendrán
const STAFF_EXTRA  = [F.ManageRoles, F.ManageMessages, F.EmbedLinks, F.AttachFiles];
const STAFF_FULL   = [...BASE_PUBLIC, ...STAFF_EXTRA];
const NO_CONNECT   = [F.ViewChannel, F.ReadMessageHistory, F.SendMessages, F.AddReactions];

// Únicos roles con permiso de borrar/gestionar canales
const CHANNEL_MANAGE_ROLES = ['1489717134878707713', '1517717411967668325'];

// Capitaliza la primera letra después del separador ・ (o al inicio si no hay)
function capitalizeVoiceName(name) {
  return name.replace(/(・|^)(.)/u, (_, sep, ch) => sep + ch.toUpperCase());
}

function buildPerms(guild, visibility, { everyoneId, staffRoles, vipRoleIds, modVoiceRoles }, opts = {}, ch = null) {
  const overwrites = [];

  // Convertir everyoneId a string para evitar problemas con BigInt
  everyoneId = String(everyoneId);

  // everyone base - DENEGAR explícitamente EmbedLinks y AttachFiles
  let everyoneDeny = [F.EmbedLinks, F.AttachFiles];
  
  // Verificar si el rol de restricción existe
  let restrictRoleExists = false;
  if (ch && ch._restrictToRole) {
    restrictRoleExists = guild.roles.cache.has(ch._restrictToRole);
  }
  
  // Verificar si los roles de restricción (array) existen
  let restrictRolesExist = false;
  if (ch && ch._restrictToRoles && Array.isArray(ch._restrictToRoles)) {
    restrictRolesExist = ch._restrictToRoles.some(rid => guild.roles.cache.has(rid));
  }
  
  // Si el canal tiene _denyMessages, también denegar SendMessages
  if (ch && ch._denyMessages) {
    everyoneDeny.push(F.SendMessages);
  }

  // Si el canal tiene _restrictToRole y el rol existe, denegar SendMessages a everyone
  if (ch && ch._restrictToRole && restrictRoleExists) {
    everyoneDeny.push(F.SendMessages);
  }

  // Si el canal tiene _restrictToRoles (array) y al menos uno existe, denegar SendMessages a everyone
  if (ch && ch._restrictToRoles && restrictRolesExist) {
    everyoneDeny.push(F.SendMessages);
  }

  switch (visibility) {
    case 'public':
      // Si hay restricción de escritura válida, no incluir SendMessages en allow
      const hasWriteRestriction = (ch && ((ch._restrictToRole && restrictRoleExists) || (ch._restrictToRoles && restrictRolesExist) || ch._denyMessages));
      const publicAllow = hasWriteRestriction 
        ? [F.ViewChannel, F.ReadMessageHistory, F.AddReactions, F.Connect]
        : [F.ViewChannel, F.ReadMessageHistory, F.SendMessages, F.AddReactions, F.Connect];
      overwrites.push({ id: everyoneId, allow: publicAllow, deny: everyoneDeny });
      break;
    case 'public-no-connect':
      const noConnectAllow = (ch && ((ch._restrictToRole && restrictRoleExists) || (ch._restrictToRoles && restrictRolesExist) || ch._denyMessages))
        ? [F.ViewChannel, F.ReadMessageHistory, F.AddReactions]
        : [F.ViewChannel, F.ReadMessageHistory, F.SendMessages, F.AddReactions];
      overwrites.push({ id: everyoneId, allow: noConnectAllow, deny: [...everyoneDeny, F.Connect] });
      break;
    case 'vip':
      overwrites.push({ id: everyoneId, allow: [F.ViewChannel, F.ReadMessageHistory], deny: [...everyoneDeny, F.SendMessages, F.Connect] });
      if (vipRoleIds && vipRoleIds.length) {
        for (const vid of vipRoleIds) overwrites.push({ id: vid, allow: BASE_PUBLIC });
      }
      break;
    case 'private':
      overwrites.push({ id: everyoneId, deny: [...everyoneDeny, F.ViewChannel] });
      break;
    case 'vip-private':
      overwrites.push({ id: everyoneId, deny: [...everyoneDeny, F.ViewChannel] });
      if (vipRoleIds && vipRoleIds.length) {
        for (const vid of vipRoleIds) overwrites.push({ id: vid, allow: BASE_PUBLIC });
      }
      break;
    default:
      overwrites.push({ id: everyoneId, allow: [F.ViewChannel, F.ReadMessageHistory], deny: everyoneDeny });
  }

  // Si el canal tiene _restrictToRole y el rol existe, permitir SendMessages solo a ese rol
  if (ch && ch._restrictToRole && restrictRoleExists) {
    overwrites.push({ id: ch._restrictToRole, allow: [F.SendMessages, F.EmbedLinks, F.AttachFiles] });
  }

  // Si el canal tiene _restrictToRoles (array), permitir SendMessages solo a esos roles que existen
  if (ch && ch._restrictToRoles && Array.isArray(ch._restrictToRoles)) {
    for (const roleId of ch._restrictToRoles) {
      if (guild.roles.cache.has(roleId)) {
        overwrites.push({ id: roleId, allow: [F.SendMessages, F.EmbedLinks, F.AttachFiles] });
      }
    }
  }

  // Restringir moderadores de mover/mutear en ciertos canales si lo requiere la categoría
  if (opts._denyVoiceMods && modVoiceRoles && modVoiceRoles.length > 0) {
    const NO_MOD_VOICE = [F.MuteMembers, F.DeafenMembers, F.MoveMembers];
    for (const rid of modVoiceRoles) {
      if (!staffRoles.includes(rid)) {
        const existing = overwrites.find(o => o.id === rid);
        if (existing) {
          existing.deny = [...(existing.deny || []), ...NO_MOD_VOICE];
        } else {
          overwrites.push({ id: rid, deny: NO_MOD_VOICE });
        }
      }
    }
  }

  // Staff: todos los permisos EXCEPTO ManageChannels
  const hasWriteRestriction = (ch && ((ch._restrictToRole && restrictRoleExists) || (ch._restrictToRoles && restrictRolesExist) || ch._denyMessages));
  for (const sid of staffRoles) {
    // Si hay restricción de escritura válida y este staff no es el rol permitido, denegar SendMessages
    if (hasWriteRestriction && ch._restrictToRole !== sid && !(ch._restrictToRoles && ch._restrictToRoles.includes(sid))) {
      overwrites.push({ id: sid, allow: STAFF_FULL, deny: [F.ManageChannels, F.SendMessages] });
    } else {
      overwrites.push({ id: sid, allow: STAFF_FULL, deny: [F.ManageChannels] });
    }
  }

  // Solo los dos roles autorizados pueden gestionar/borrar canales
  for (const rid of CHANNEL_MANAGE_ROLES) {
    const existing = overwrites.find(o => o.id === rid);
    if (existing) {
      existing.allow = [...(existing.allow || []), F.ManageChannels];
      existing.deny  = (existing.deny || []).filter(p => p !== F.ManageChannels);
    } else {
      // Si hay restricción válida y este role no es el permitido, denegar SendMessages
      if (hasWriteRestriction && ch._restrictToRole !== rid && !(ch._restrictToRoles && ch._restrictToRoles.includes(rid))) {
        overwrites.push({ id: rid, allow: [...STAFF_FULL, F.ManageChannels], deny: [F.SendMessages] });
      } else {
        overwrites.push({ id: rid, allow: [...STAFF_FULL, F.ManageChannels] });
      }
    }
  }

  // VALIDACIÓN CRUCIAL: Discord arroja "Supplied parameter is not a cached User or Role"
  // si enviamos un ID que no pertenece al servidor. Filtramos asegurando que existan localmente.
  const filtered = overwrites.filter(o => o.id === everyoneId || guild.roles.cache.has(o.id));
  
  // Convertir todos los IDs a strings para evitar problemas con BigInt
  return filtered.map(o => ({ ...o, id: String(o.id) }));
}

// ─── Layout del servidor ──────────────────────────────────────────────────────
// Estructura basada en DISCORD_IDS_SERVIDOR_COMPLETO.txt

const SUPERSCRIPTS = ['⁰','¹','²','³','⁴','⁵','⁶','⁷','⁸','⁹'];
function toSuperscript(n) {
  return String(n).split('').map(d => SUPERSCRIPTS[parseInt(d)] || d).join('');
}

function buildMatchRooms(from, to) {
  const channels = [];
  for (let i = from; i <= to; i++) {
    const num = String(i).padStart(2, '0');
    channels.push({ name: `#${num} - Time 1`, type: ChannelType.GuildVoice });
    channels.push({ name: `#${num} - Time 2`, type: ChannelType.GuildVoice });
  }
  return channels;
}

function buildWaitingRooms(from, to) {
  const channels = [];
  for (let i = from; i <= to; i++) {
    channels.push({ name: `🩸・Esperando${toSuperscript(i)}`, type: ChannelType.GuildVoice });
  }
  return channels;
}

